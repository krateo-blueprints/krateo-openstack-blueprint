{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "OpenStack capabilities (per cluster)",
  "description": "GENERATED by hack/gen-capabilities-chart.py from the umbrella's values.schema.json. The capability ClusterRoles and admission guards of the OpenStack blueprint, rendered from the same serviceContract the umbrella takes. Other top-level keys are accepted and ignored, so the umbrella's values file can be passed unchanged.",
  "required": [
    "serviceContract"
  ],
  "properties": {
    "serviceContract": {
      "type": "object",
      "required": [
        "version",
        "service",
        "identity",
        "roleMapping",
        "capabilities",
        "sso",
        "usage",
        "health",
        "tagging",
        "ticketing"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v1",
          "description": "Contract version this stanza conforms to."
        },
        "service": {
          "type": "object",
          "required": [
            "name",
            "displayName"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "description": "DNS-1123 service identifier, used as prefix for rendered resources."
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "owner": {
              "type": "string",
              "description": "Team or contact owning this service adapter."
            }
          }
        },
        "identity": {
          "type": "object",
          "required": [
            "keycloak"
          ],
          "additionalProperties": false,
          "description": "Identity federation wiring: Keycloak client, optional IdP broker, and the groups mapper.",
          "properties": {
            "keycloak": {
              "type": "object",
              "required": [
                "client",
                "groupsMapper"
              ],
              "additionalProperties": false,
              "properties": {
                "client": {
                  "type": "object",
                  "required": [
                    "clientId"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "clientId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "realmRef": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Name of the KeycloakRealm CR of the owning Org. Defaults to the Org realm when omitted."
                    },
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "openid-connect",
                        "saml"
                      ],
                      "default": "openid-connect"
                    }
                  }
                },
                "groupsMapper": {
                  "type": "object",
                  "required": [
                    "claim"
                  ],
                  "additionalProperties": false,
                  "description": "Protocol mapper exposing group membership in tokens issued to this client.",
                  "properties": {
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "default": "groups"
                    },
                    "fullPath": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                },
                "idpBroker": {
                  "type": "object",
                  "required": [
                    "alias"
                  ],
                  "additionalProperties": false,
                  "description": "Optional identity-provider broker this service's logins are federated through.",
                  "properties": {
                    "alias": {
                      "type": "string",
                      "minLength": 1
                    },
                    "providerRef": {
                      "type": "string",
                      "description": "Name of the KeycloakIdentityProvider CR."
                    }
                  }
                }
              }
            }
          }
        },
        "roleMapping": {
          "type": "array",
          "minItems": 1,
          "description": "Mandatory map from CMP roles/capabilities to the service's native roles, reconciled by the service adapter into the native system. No service onboards without declaring it.",
          "items": {
            "type": "object",
            "required": [
              "cmpRole",
              "nativeRole"
            ],
            "additionalProperties": false,
            "properties": {
              "cmpRole": {
                "type": "string",
                "minLength": 1,
                "description": "CMP role or capability name (see capabilities[].name / aggregateTo)."
              },
              "nativeRole": {
                "type": "string",
                "minLength": 1,
                "description": "Role name in the service's native authorization system."
              },
              "scope": {
                "type": "string",
                "description": "Optional native scope the role binds at (e.g. project, organization, folder)."
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "description": "Atomic, human-readable permissions this service contributes to the capability catalog. Each capability renders one aggregation-labeled ClusterRole; ABAC capabilities additionally render a Kyverno ClusterPolicy.",
          "items": {
            "$ref": "#/definitions/capability"
          }
        },
        "sso": {
          "type": "object",
          "required": [
            "deepLink",
            "logout"
          ],
          "additionalProperties": false,
          "properties": {
            "deepLink": {
              "type": "object",
              "required": [
                "urlTemplate"
              ],
              "additionalProperties": false,
              "properties": {
                "urlTemplate": {
                  "type": "string",
                  "pattern": "^https://[^{}\\s]*(\\{(org|tenant|namespace|project)\\}[^{}\\s]*)*$",
                  "description": "Context deep-link into the service's native console. Placeholders: {org}, {tenant}, {namespace}, {project}."
                },
                "preRedirect": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "Optional step executed before redirecting (e.g. native token rescoping).",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "none",
                        "token-rescope",
                        "custom"
                      ]
                    },
                    "endpoint": {
                      "type": "string",
                      "pattern": "^https://"
                    }
                  },
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "token-rescope",
                          "custom"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "endpoint"
                    ]
                  }
                }
              }
            },
            "logout": {
              "type": "object",
              "required": [
                "mode"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "oidc-backchannel",
                    "saml-slo"
                  ],
                  "description": "oidc-backchannel is the default; saml-slo only for SAML-only consoles."
                },
                "backchannelLogoutUrl": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "sloUrl": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "sessionMaxTtl": {
                  "type": "string",
                  "pattern": "^[0-9]+(s|m|h)$",
                  "description": "Session TTL to keep aligned with the CMP session and downstream tokens."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "oidc-backchannel"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "backchannelLogoutUrl"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "saml-slo"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "sloUrl"
                    ]
                  }
                }
              ]
            }
          }
        },
        "usage": {
          "type": "object",
          "required": [
            "interval",
            "metrics"
          ],
          "additionalProperties": false,
          "description": "UsageRecord emission declaration. Every record implicitly carries org/tenant/service/resource dimensions plus resource tags; metrics declared here define the service-specific shape consumed uniformly by dashboards and rating.",
          "properties": {
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$",
              "description": "Emission interval."
            },
            "metrics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "unit",
                  "kind"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+([._][a-z0-9]+)*$"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "gauge",
                      "counter",
                      "capacity"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "dimensions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]([-_a-z0-9]*[a-z0-9])?$"
                    },
                    "description": "Extra per-metric dimensions beyond the implicit org/tenant/service/resource/tags."
                  }
                }
              }
            }
          }
        },
        "health": {
          "type": "object",
          "required": [
            "interval",
            "source"
          ],
          "additionalProperties": false,
          "description": "Normalized health emission. The adapter must map the native signal onto exactly: OK | Warning | Critical | Unknown.",
          "properties": {
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$"
            },
            "source": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "endpoint",
                    "metric",
                    "adapter"
                  ],
                  "description": "endpoint: probe an HTTPS endpoint; metric: derive from emitted usage metrics; adapter: the adapter computes it natively."
                },
                "endpoint": {
                  "type": "string",
                  "pattern": "^https://"
                }
              },
              "if": {
                "properties": {
                  "type": {
                    "const": "endpoint"
                  }
                }
              },
              "then": {
                "required": [
                  "endpoint"
                ]
              }
            }
          }
        },
        "tagging": {
          "type": "object",
          "required": [
            "native"
          ],
          "additionalProperties": false,
          "description": "Tag support declaration. Non-tag-native services are tracked in the shared tag registry; remediation declares whether the adapter can patch tags on existing resources.",
          "properties": {
            "native": {
              "type": "boolean",
              "description": "Whether the underlying service supports tags/labels natively."
            },
            "remediation": {
              "type": "boolean",
              "default": false,
              "description": "Whether the adapter can patch tags on existing resources (used by governance remediation)."
            },
            "keyPattern": {
              "type": "string",
              "description": "Optional regex constraining tag keys accepted by the native system."
            },
            "maxTagsPerResource": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "ticketing": {
          "type": "object",
          "required": [
            "category"
          ],
          "additionalProperties": false,
          "description": "Support-ticket classification and routing hints for tickets opened in the context of this service.",
          "properties": {
            "category": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "subcategory": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "routing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "queue": {
                  "type": "string",
                  "minLength": 1
                },
                "defaultPriority": {
                  "type": "string",
                  "enum": [
                    "low",
                    "normal",
                    "high",
                    "urgent"
                  ],
                  "default": "normal"
                }
              }
            }
          }
        }
      },
      "description": "Service integration descriptor (contract v1): identity federation, role mapping, capabilities, SSO deep-link, usage/health, tagging, ticketing. Chart defaults are authoritative; deployments override only environment-specific fields (URLs, realm)."
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "required": [
        "name",
        "title",
        "enforcement",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable permission shown in the role composer."
        },
        "description": {
          "type": "string"
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "rbac",
            "acr",
            "cross-org",
            "abac"
          ],
          "description": "Enforcement layer: rbac = Kubernetes RBAC only; acr = auth-strength/step-up on top of RBAC; cross-org = central parent-realm role; abac = attribute/conditional rule (Kyverno CEL) on top of RBAC."
        },
        "requiresAcr": {
          "type": "string",
          "minLength": 1,
          "description": "ACR/LoA the caller's token must satisfy (step-up is triggered otherwise). Required when enforcement is 'acr'."
        },
        "crossOrgRole": {
          "type": "string",
          "minLength": 1,
          "description": "Central parent-realm role backing this capability. Required when enforcement is 'cross-org'."
        },
        "aggregateTo": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "description": "Predefined roles this capability aggregates into (rendered as rbac.krateo.io/aggregate-to-<role> labels)."
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/policyRule"
          }
        },
        "abac": {
          "type": "object",
          "required": [
            "celExpression",
            "match"
          ],
          "additionalProperties": false,
          "description": "Attribute/conditional rule rendered as a Kyverno ClusterPolicy (CEL). Required when enforcement is 'abac'.",
          "properties": {
            "celExpression": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "match": {
              "type": "object",
              "required": [
                "kinds"
              ],
              "additionalProperties": false,
              "properties": {
                "kinds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforcement": {
                "const": "acr"
              }
            },
            "required": [
              "enforcement"
            ]
          },
          "then": {
            "required": [
              "requiresAcr"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enforcement": {
                "const": "cross-org"
              }
            },
            "required": [
              "enforcement"
            ]
          },
          "then": {
            "required": [
              "crossOrgRole"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enforcement": {
                "const": "abac"
              }
            },
            "required": [
              "enforcement"
            ]
          },
          "then": {
            "required": [
              "abac"
            ]
          }
        }
      ]
    },
    "policyRule": {
      "type": "object",
      "required": [
        "apiGroups",
        "resources",
        "verbs"
      ],
      "additionalProperties": false,
      "properties": {
        "apiGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resourceNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "get",
              "list",
              "watch",
              "create",
              "update",
              "patch",
              "delete",
              "deletecollection",
              "*"
            ]
          }
        }
      }
    }
  }
}
