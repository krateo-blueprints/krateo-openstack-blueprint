{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "OpenStack horizon",
  "description": "Configuration for the Horizon dashboard (OpenStack-Helm horizon, release 2025.1). Only the fields here are settable on a Composition; everything else uses the chart defaults in values.yaml. Deploy all the OpenStack component blueprints into one namespace to form a complete install.",
  "properties": {
    "images": {
      "type": "object",
      "title": "Images",
      "properties": {
        "pull_policy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "pod": {
      "type": "object",
      "title": "Pods",
      "properties": {
        "replicas": {
          "type": "object",
          "title": "Replicas",
          "properties": {
            "server": {
              "type": "integer",
              "title": "Horizon replicas",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "network": {
      "type": "object",
      "title": "Network",
      "properties": {
        "dashboard": {
          "type": "object",
          "title": "Dashboard",
          "properties": {
            "service": {
              "type": "object",
              "title": "Service",
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Service type",
                  "description": "How to expose Horizon. NodePort (default; uses the NodePort below), LoadBalancer (external L4 LB + public IP on GKE/EKS/AKS), or ClusterIP (in-cluster only).",
                  "enum": [
                    "NodePort",
                    "LoadBalancer",
                    "ClusterIP"
                  ],
                  "default": "NodePort"
                },
                "annotations": {
                  "type": "object",
                  "title": "Service annotations",
                  "description": "Annotations for the Service, e.g. cloud LB controls (internal LB, static IP, ...).",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "x-kubernetes-preserve-unknown-fields": true
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        },
        "node_port": {
          "type": "object",
          "title": "NodePort",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Expose on NodePort",
              "default": true
            },
            "port": {
              "type": "integer",
              "title": "Dashboard NodePort",
              "minimum": 30000,
              "maximum": 32767,
              "default": 31000
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "conf": {
      "type": "object",
      "title": "OpenStack-Helm conf overrides",
      "description": "Horizon WebSSO overrides. The auth subtree (sso.* + idp_mapping[]) is irregular, so it is carried with preserve-unknown-fields rather than fully typed (see schema-extension-plan.md, crdgen risk).",
      "properties": {
        "horizon": {
          "type": "object",
          "properties": {
            "backchannel_logout": {
              "type": "object",
              "title": "OIDC back-channel logout receiver",
              "description": "POST /auth/backchannel-logout/ on Horizon. On a valid logout token it ends EVERY Horizon session of that user (matched by sub), revoking their Keystone tokens, then forwards the token to mod_auth_openidc on Keystone. Needs session_engine django.contrib.sessions.backends.db. See values.yaml.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "title": "Enabled",
                  "description": "Serve the receiver and record each federated user's subject at login."
                },
                "issuer": {
                  "type": "string",
                  "title": "Issuer",
                  "description": "The realm issuer exactly as Keycloak writes iss (<keycloak hostname>/realms/<realm>). Compared with the token, never derived from it. Required when enabled."
                },
                "audience": {
                  "type": "string",
                  "title": "Audience",
                  "description": "Keystone's OIDC client id in Keycloak: the token's aud. Required when enabled."
                },
                "jwks_url": {
                  "type": "string",
                  "title": "JWKS URL",
                  "description": "<issuer>/protocol/openid-connect/certs, reachable from the Horizon pod. Required when enabled."
                },
                "forward_url": {
                  "type": "string",
                  "title": "Forward URL",
                  "description": "mod_auth_openidc's back-channel endpoint: Keystone's OIDCRedirectURI path on an address Horizon reaches, plus ?logout=backchannel. Required when enabled."
                },
                "identity_provider": {
                  "type": "string",
                  "title": "Identity provider",
                  "description": "Record only unique ids from this Keystone identity provider (federated[].idp_id). Empty: every identity provider."
                },
                "keystone_url": {
                  "type": "string",
                  "title": "Keystone URL",
                  "description": "Keystone API for token revocation and the login-time user lookup. Empty: Horizon's OPENSTACK_KEYSTONE_URL."
                },
                "iat_skew_seconds": {
                  "type": "integer",
                  "title": "Clock skew",
                  "description": "Seconds of clock skew tolerated on iat and exp."
                },
                "max_token_age_seconds": {
                  "type": "integer",
                  "title": "Maximum token age",
                  "description": "Oldest iat accepted, in seconds (plus the skew). Keycloak's logout tokens live 120 s."
                },
                "require_typ": {
                  "type": "boolean",
                  "title": "Require typ",
                  "description": "Require the JWS header typ logout+jwt (Keycloak 26 sends it). A typ that is present must say logout+jwt regardless."
                },
                "timeout_seconds": {
                  "type": "integer",
                  "title": "Timeout",
                  "description": "Timeout of each JWKS, Keystone and forward request, in seconds."
                },
                "jwks_cache_seconds": {
                  "type": "integer",
                  "title": "JWKS cache",
                  "description": "How long fetched realm keys are reused, in seconds."
                },
                "ca_bundle_ref": {
                  "type": "object",
                  "title": "CA bundle reference",
                  "description": "The ConfigMap or Secret holding the CA certificate (PEM) for the receiver's https URLs, for an IdP behind a private CA. The chart mounts it read-only and points the receiver at it; TLS validation stays on. Empty name and key: the system trust store.",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "title": "Kind",
                      "enum": [
                        "ConfigMap",
                        "Secret"
                      ],
                      "default": "ConfigMap"
                    },
                    "name": {
                      "type": "string",
                      "title": "Name",
                      "default": ""
                    },
                    "key": {
                      "type": "string",
                      "title": "Key",
                      "default": "",
                      "description": "The data key holding the PEM certificate(s), e.g. ca.crt."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            },
            "local_settings": {
              "type": "object",
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "auth": {
                      "type": "object",
                      "title": "Auth / WebSSO",
                      "description": "sso.enabled, sso.initial_choice, sso.websso_keystone_url, idp_mapping[].",
                      "x-kubernetes-preserve-unknown-fields": true
                    },
                    "session_engine": {
                      "type": "string",
                      "title": "Session engine",
                      "description": "Django session engine. django.contrib.sessions.backends.db (the default) keeps sessions in Horizon's MariaDB, which the back-channel logout receiver requires. Changing it logs every Horizon user out once."
                    }
                  },
                  "x-kubernetes-preserve-unknown-fields": true
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "manifests": {
      "type": "object",
      "title": "Manifest switches",
      "description": "Deep-merged into the chart's manifests values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "properties": {
        "certificates": {
          "type": "boolean"
        },
        "configmap_bin": {
          "type": "boolean"
        },
        "configmap_etc": {
          "type": "boolean"
        },
        "configmap_logo": {
          "type": "boolean"
        },
        "deployment": {
          "type": "boolean"
        },
        "ingress_api": {
          "type": "boolean"
        },
        "job_db_drop": {
          "type": "boolean"
        },
        "job_db_init": {
          "type": "boolean"
        },
        "job_db_sync": {
          "type": "boolean"
        },
        "job_image_repo_sync": {
          "type": "boolean"
        },
        "network_policy": {
          "type": "boolean"
        },
        "pdb": {
          "type": "boolean"
        },
        "pod_helm_test": {
          "type": "boolean"
        },
        "secret_db": {
          "type": "boolean"
        },
        "secret_ingress_tls": {
          "type": "boolean"
        },
        "secret_keystone": {
          "type": "boolean"
        },
        "secret_registry": {
          "type": "boolean"
        },
        "service": {
          "type": "boolean"
        },
        "service_ingress": {
          "type": "boolean"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "endpoints": {
      "type": "object",
      "title": "Endpoint overrides",
      "description": "Deep-merged into the chart's endpoints values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "dependencies": {
      "type": "object",
      "title": "dependencies",
      "description": "Deep-merged into the chart's `dependencies` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "x-kubernetes-preserve-unknown-fields": true
      },
      "title": "extraObjects",
      "description": "Deep-merged into the chart's `extraObjects` values."
    },
    "identity": {
      "type": "object",
      "title": "identity",
      "description": "Deep-merged into the chart's `identity` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "labels": {
      "type": "object",
      "properties": {
        "dashboard": {
          "type": "object",
          "properties": {
            "node_selector_key": {
              "type": "string"
            },
            "node_selector_value": {
              "type": "string"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        },
        "job": {
          "type": "object",
          "properties": {
            "node_selector_key": {
              "type": "string"
            },
            "node_selector_value": {
              "type": "string"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        },
        "test": {
          "type": "object",
          "properties": {
            "node_selector_key": {
              "type": "string"
            },
            "node_selector_value": {
              "type": "string"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "title": "labels",
      "description": "Deep-merged into the chart's `labels` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "network_policy": {
      "type": "object",
      "title": "network_policy",
      "description": "Deep-merged into the chart's `network_policy` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "release_group": {
      "type": [
        "string",
        "null"
      ],
      "title": "release_group",
      "description": "The chart's `release_group` value."
    },
    "secrets": {
      "type": "object",
      "title": "secrets",
      "description": "Deep-merged into the chart's `secrets` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "selenium_v4": {
      "type": "boolean",
      "title": "selenium_v4",
      "description": "The chart's `selenium_v4` value."
    },
    "tls": {
      "type": "object",
      "title": "tls",
      "description": "Deep-merged into the chart's `tls` values.",
      "x-kubernetes-preserve-unknown-fields": true
    }
  }
}
