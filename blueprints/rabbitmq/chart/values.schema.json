          "properties": {
            "server": {
              "type": "integer",
              "title": "RabbitMQ server replicas",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "volume": {
      "type": "object",
      "title": "Volume",
      "description": "The PersistentVolumeClaim holding the broker's users, vhosts and durable queues. Read when the StatefulSet is first created: Kubernetes refuses a later change to it.",
      "properties": {
        "class_name": {
          "type": "string",
          "title": "StorageClass",
          "description": "StorageClass for the claim. `default` leaves it unset, so the cluster's default class is used.",
          "default": "default"
        },
        "size": {
          "type": "string",
          "title": "Size",
          "description": "Requested capacity, as a Kubernetes quantity.",
          "default": "768Mi",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        }
      },
