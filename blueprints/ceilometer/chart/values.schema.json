{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "OpenStack ceilometer",
  "description": "Configuration for the OpenStack ceilometer service (OpenStack-Helm ceilometer, release 2025.1). Only the fields here are settable on a Composition; everything else uses the chart defaults in values.yaml. Deploy all the OpenStack component blueprints into one namespace to form a complete install.",
  "properties": {
    "images": {
      "type": "object",
      "title": "Images",
      "properties": {
        "pull_policy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "pod": {
      "type": "object",
      "title": "Pods",
      "properties": {
        "replicas": {
          "type": "object",
          "title": "Replicas",
          "properties": {
            "central": {
              "type": "integer",
              "title": "Ceilometer central replicas",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            },
            "notification": {
              "type": "integer",
              "title": "Ceilometer notification replicas",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "conf": {
      "type": "object",
      "title": "OpenStack-Helm conf overrides",
      "description": "Deep-merged into the chart's conf values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "manifests": {
      "type": "object",
      "title": "Manifest switches",
      "description": "Deep-merged into the chart's manifests values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "properties": {
        "configmap_bin": {
          "type": "boolean"
        },
        "configmap_etc": {
          "type": "boolean"
        },
        "deployment_central": {
          "type": "boolean"
        },
        "daemonset_compute": {
          "type": "boolean"
        },
        "daemonset_ipmi": {
          "type": "boolean"
        },
        "deployment_notification": {
          "type": "boolean"
        },
        "job_bootstrap": {
          "type": "boolean"
        },
        "job_db_sync": {
          "type": "boolean"
        },
        "job_image_repo_sync": {
          "type": "boolean"
        },
        "job_ks_user": {
          "type": "boolean"
        },
        "job_rabbit_init": {
          "type": "boolean"
        },
        "secret_keystone": {
          "type": "boolean"
        },
        "secret_rabbitmq": {
          "type": "boolean"
        },
        "secret_registry": {
          "type": "boolean"
        },
        "service_api": {
          "type": "boolean"
        },
        "service_ingress_api": {
          "type": "boolean"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "endpoints": {
      "type": "object",
      "title": "Endpoint overrides",
      "description": "Deep-merged into the chart's endpoints values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    }
  }
}