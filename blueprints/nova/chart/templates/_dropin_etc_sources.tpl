{{/* Krateo (#228), generated by 0.3.66 step 2: every drop-in source this chart's workloads use, as a JSON list in
     pod.etcSources form. Every container that mounts the main config receives these, Jobs included (0.3.65's
     ceilometer-db-sync, given none, failed its post-upgrade hook). Each entry renders only when its secret is
     generated, so with no reference the list is empty and nothing changes. */}}
{{- define "nova.dropin_etc_sources" -}}
{{- $out := list -}}
{{- with include "helm-toolkit.snippets.memcache_secret_key_etc_source" (tuple . "nova") }}{{- $out = append $out (fromJson .) }}{{- end }}
{{- with include "helm-toolkit.snippets.secret_conf_dropin_etc_source" (dict "from" (include "helm-toolkit.utils.metadata_proxy_secret_ref" . | fromJson) "name" "nova-metadata-proxy-secret") }}{{- $out = append $out (fromJson .) }}{{- end }}
{{- with include "helm-toolkit.snippets.db_dropin_etc_source" (tuple . (include "nova.db_dropin_entries" . | fromJsonArray) "nova") }}{{- $out = append $out (fromJson .) }}{{- end }}
{{- $out | toJson -}}
{{- end -}}

{{/* Krateo (#228, 0.3.69): the drop-ins of the db-sync Job, whose programs use RabbitMQ (hack/mq-readers.yaml: nova-manage builds a transport on every parse (nova.config.parse_args: rpc.init), and the cell mapping templates are formatted from [DEFAULT] transport_url): nova.dropin_etc_sources plus nova-transport, the RabbitMQ URLs. */}}
{{- define "nova.db_sync_etc_sources" -}}
{{- $out := include "nova.dropin_etc_sources" . | fromJsonArray -}}
{{- with include "helm-toolkit.snippets.transport_dropin_etc_source" (tuple . (include "nova.transport_dropin_entries" . | fromJsonArray) "nova") }}{{- $out = append $out (fromJson .) }}{{- end }}
{{- $out | toJson -}}
{{- end -}}
