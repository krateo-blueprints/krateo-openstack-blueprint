{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "PowerDNS Authoritative Server",
  "description": "Configuration for PowerDNS, the pdns4 pool target designate provisions zones into. Only the fields here are settable on a Composition; everything else uses the chart defaults in values.yaml. The API key designate authenticates with is NOT settable and is not a chart default: a Job mints it into a Secret on first install and leaves it alone afterwards, so it is never rendered into a manifest or committed to this repository. Deploy all the OpenStack component blueprints into one namespace to form a complete install.",
  "properties": {
    "images": {
      "type": "object",
      "title": "Images",
      "properties": {
        "pull_policy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "pod": {
      "type": "object",
      "title": "Pod",
      "properties": {
        "replicas": {
          "type": "object",
          "title": "Replicas",
          "properties": {
            "powerdns": {
              "type": "integer",
              "title": "PowerDNS replicas",
              "description": "Authoritative servers. All replicas read the same gmysql database, so they serve identical zone data.",
              "minimum": 1,
              "default": 1
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "conf": {
      "type": "object",
      "title": "PowerDNS configuration",
      "properties": {
        "pdns": {
          "type": "object",
          "title": "pdns.conf",
          "properties": {
            "webserver-allow-from": {
              "type": "string",
              "title": "API clients allowed",
              "description": "CIDRs permitted to reach the HTTP API on 8081. The default 0.0.0.0/0 is permissive because a pod CIDR is not knowable from a chart; narrow it to your cluster's pod CIDR. designate-worker is the only client that needs it, and 127.0.0.1 is always added for the probes.",
              "default": "0.0.0.0/0"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "manifests": {
      "type": "object",
      "title": "Manifest switches",
      "description": "Deep-merged into the chart's manifests values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "properties": {
        "configmap_bin": {
          "type": "boolean"
        },
        "configmap_etc": {
          "type": "boolean"
        },
        "deployment": {
          "type": "boolean"
        },
        "job_db_init": {
          "type": "boolean"
        },
        "job_db_sync": {
          "type": "boolean"
        },
        "job_image_repo_sync": {
          "type": "boolean"
        },
        "network_policy": {
          "type": "boolean"
        },
        "secret_db": {
          "type": "boolean"
        },
        "job_api_key_init": {
          "type": "boolean"
        },
        "secret_registry": {
          "type": "boolean"
        },
        "service": {
          "type": "boolean"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "endpoints": {
      "type": "object",
      "title": "Endpoint overrides",
      "description": "Deep-merged into the chart's endpoints values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "network": {
      "type": "object",
      "title": "Network overrides",
      "description": "Deep-merged into the chart's network values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "release_group": {
      "type": [
        "string",
        "null"
      ],
      "title": "release_group",
      "description": "The chart's `release_group` value."
    },
    "labels": {
      "type": "object",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "node_selector_key": {
              "type": "string"
            },
            "node_selector_value": {
              "type": "string"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        },
        "job": {
          "type": "object",
          "properties": {
            "node_selector_key": {
              "type": "string"
            },
            "node_selector_value": {
              "type": "string"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "title": "labels",
      "description": "Deep-merged into the chart's `labels` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "secrets": {
      "type": "object",
      "title": "secrets",
      "description": "Deep-merged into the chart's `secrets` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "dependencies": {
      "type": "object",
      "title": "dependencies",
      "description": "Deep-merged into the chart's `dependencies` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "network_policy": {
      "type": "object",
      "title": "network_policy",
      "description": "Deep-merged into the chart's `network_policy` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "x-kubernetes-preserve-unknown-fields": true
      },
      "title": "extraObjects",
      "description": "Deep-merged into the chart's `extraObjects` values."
    }
  }
}
