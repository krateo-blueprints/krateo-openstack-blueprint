{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "OpenStack ironic",
  "description": "Configuration for the Ironic bare-metal provisioning service (OpenStack-Helm ironic, release 2025.1). Only the fields here are settable on a Composition; everything else uses the chart defaults in values.yaml. Deploy all the OpenStack component blueprints into one namespace to form a complete install. Production-grade real-driver deploy (ipmi/redfish, iPXE/PXE, conductor on hostNetwork). The driver stack (conf.ironic.*) is fixed in values.yaml to avoid the crdgen Kind-vs-'ironic' property collision; the conductor needs a node with the provisioning NIC labelled openstack-control-plane=enabled.",
  "properties": {
    "images": {
      "type": "object",
      "title": "Images",
      "properties": {
        "pull_policy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "pod": {
      "type": "object",
      "title": "Pod",
      "properties": {
        "replicas": {
          "type": "object",
          "title": "Replica counts",
          "properties": {
            "api": {
              "type": "integer",
              "title": "ironic-api replicas",
              "minimum": 1,
              "default": 1
            },
            "conductor": {
              "type": "integer",
              "title": "ironic-conductor replicas",
              "minimum": 1,
              "default": 1
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "labels": {
      "type": "object",
      "title": "Scheduling labels",
      "properties": {
        "conductor": {
          "type": "object",
          "title": "Conductor node selector",
          "description": "The conductor uses hostNetwork for PXE/TFTP/HTTP-boot and must land on a node attached to the provisioning network.",
          "properties": {
            "node_selector_key": {
              "type": "string",
              "default": "openstack-control-plane"
            },
            "node_selector_value": {
              "type": "string",
              "default": "enabled"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "network": {
      "type": "object",
      "title": "Provisioning network",
      "properties": {
        "pxe": {
          "type": "object",
          "title": "PXE / provisioning",
          "properties": {
            "device": {
              "type": "string",
              "title": "Provisioning NIC",
              "description": "Host interface name inside the conductor pod used for PXE/TFTP (PROVISIONER_INTERFACE).",
              "default": "ironic-pxe"
            },
            "neutron_provider_network": {
              "type": "string",
              "title": "Provider network type/name",
              "default": "ironic"
            },
            "neutron_subnet_cidr": {
              "type": "string",
              "title": "Provisioning subnet CIDR",
              "default": "172.24.6.0/24"
            },
            "neutron_subnet_gateway": {
              "type": "string",
              "title": "Provisioning subnet gateway",
              "default": "172.24.6.1/24"
            },
            "neutron_subnet_alloc_start": {
              "type": "string",
              "title": "DHCP allocation start",
              "default": "172.24.6.100"
            },
            "neutron_subnet_alloc_end": {
              "type": "string",
              "title": "DHCP allocation end",
              "default": "172.24.6.200"
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "conf": {
      "type": "object",
      "title": "OpenStack-Helm conf overrides",
      "description": "Deep-merged into the chart's conf values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "manifests": {
      "type": "object",
      "title": "Manifest switches",
      "description": "Deep-merged into the chart's manifests values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "properties": {
        "configmap_bin": {
          "type": "boolean"
        },
        "configmap_etc": {
          "type": "boolean"
        },
        "deployment_api": {
          "type": "boolean"
        },
        "ingress_api": {
          "type": "boolean"
        },
        "job_bootstrap": {
          "type": "boolean"
        },
        "job_db_drop": {
          "type": "boolean"
        },
        "job_db_init": {
          "type": "boolean"
        },
        "job_db_sync": {
          "type": "boolean"
        },
        "job_image_repo_sync": {
          "type": "boolean"
        },
        "job_ks_endpoints": {
          "type": "boolean"
        },
        "job_ks_service": {
          "type": "boolean"
        },
        "job_ks_user": {
          "type": "boolean"
        },
        "job_manage_cleaning_network": {
          "type": "boolean"
        },
        "job_rabbit_init": {
          "type": "boolean"
        },
        "pdb_api": {
          "type": "boolean"
        },
        "network_policy": {
          "type": "boolean"
        },
        "secret_db": {
          "type": "boolean"
        },
        "secret_keystone": {
          "type": "boolean"
        },
        "secret_rabbitmq": {
          "type": "boolean"
        },
        "secret_registry": {
          "type": "boolean"
        },
        "service_api": {
          "type": "boolean"
        },
        "service_ingress_api": {
          "type": "boolean"
        },
        "statefulset_conductor": {
          "type": "boolean"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "endpoints": {
      "type": "object",
      "title": "Endpoint overrides",
      "description": "Deep-merged into the chart's endpoints values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "release_group": {
      "type": [
        "string",
        "null"
      ],
      "title": "release_group",
      "description": "The chart's `release_group` value."
    },
    "helm3_hook": {
      "type": "boolean",
      "title": "helm3_hook",
      "description": "The chart's `helm3_hook` value."
    },
    "conductor": {
      "type": "object",
      "title": "conductor",
      "description": "Deep-merged into the chart's `conductor` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "bootstrap": {
      "type": "object",
      "title": "bootstrap",
      "description": "Deep-merged into the chart's `bootstrap` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "dependencies": {
      "type": "object",
      "title": "dependencies",
      "description": "Deep-merged into the chart's `dependencies` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "secrets": {
      "type": "object",
      "title": "secrets",
      "description": "Deep-merged into the chart's `secrets` values.",
      "x-kubernetes-preserve-unknown-fields": true
    },
    "network_policy": {
      "type": "object",
      "title": "network_policy",
      "description": "Deep-merged into the chart's `network_policy` values.",
      "x-kubernetes-preserve-unknown-fields": true
    }
  }
}
