{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "OpenStack keystone",
  "description": "Configuration for the Keystone identity service (OpenStack-Helm keystone, release 2025.1). Only the fields here are settable on a Composition; everything else uses the chart defaults in values.yaml. Deploy all the OpenStack component blueprints into one namespace to form a complete install.",
  "properties": {
    "images": {
      "type": "object",
      "title": "Images",
      "properties": {
        "pull_policy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        },
        "tags": {
          "type": "object",
          "title": "Image tag overrides",
          "description": "Override specific component images (e.g. a keystone image that ships mod_auth_openidc for OIDC federation).",
          "properties": {
            "keystone_api": {
              "type": "string",
              "title": "Keystone API image",
              "description": "Full image ref for the keystone-api container, e.g. ghcr.io/krateo-blueprints/keystone-oidc:2025.1-ubuntu_jammy."
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "pod": {
      "type": "object",
      "title": "Pods",
      "properties": {
        "replicas": {
          "type": "object",
          "title": "Replicas",
          "properties": {
            "api": {
              "type": "integer",
              "title": "Keystone API replicas",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "network": {
      "type": "object",
      "title": "Network",
      "description": "External exposure of the Keystone API. The OIDC redirect chain runs through the browser, so Keystone must be reachable at a public HTTPS hostname. NodePort is the low-friction path; production fronts it with an ingress/Gateway that terminates TLS.",
      "properties": {
        "api": {
          "type": "object",
          "title": "API",
          "properties": {
            "node_port": {
              "type": "object",
              "title": "NodePort",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "title": "Expose the API on a NodePort",
                  "default": false
                },
                "port": {
                  "type": "integer",
                  "title": "Keystone API NodePort",
                  "minimum": 30000,
                  "maximum": 32767,
                  "default": 30500
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "conf": {
      "type": "object",
      "title": "OpenStack-Helm conf overrides",
      "description": "OIDC federation overrides merged into the keystone conf tree. NB: this subtree is intentionally shallow-typed with preserve-unknown-fields on the free-form parts (wsgi_keystone, federation) because the upstream OSH conf tree is large and irregular and does not round-trip cleanly through crdgen (see schema-extension-plan.md, crdgen risk).",
      "properties": {
        "keystone": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "object",
              "properties": {
                "methods": {
                  "type": "string",
                  "title": "Auth methods",
                  "description": "e.g. password,token,openid"
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            },
            "openid": {
              "type": "object",
              "properties": {
                "remote_id_attribute": {
                  "type": "string",
                  "title": "Remote ID attribute",
                  "description": "Apache env var carrying the token issuer, e.g. HTTP_OIDC_ISS."
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            },
            "federation": {
              "type": "object",
              "title": "Federation",
              "description": "trusted_dashboard[], sso_callback_template, ... (free-form).",
              "x-kubernetes-preserve-unknown-fields": true
            },
            "auto_provisioning": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "title": "JIT auto-provisioning",
                  "default": false
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        },
        "software": {
          "type": "object",
          "properties": {
            "apache2": {
              "type": "object",
              "properties": {
                "a2enmod": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "title": "Apache modules to enable",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "x-kubernetes-preserve-unknown-fields": true
            }
          },
          "x-kubernetes-preserve-unknown-fields": true
        },
        "wsgi_keystone": {
          "type": "string",
          "title": "Keystone Apache vhost",
          "description": "Full Apache vhost template (mod_auth_openidc OIDC RP config + protected federation Locations). Helm-templated (uses helm-toolkit endpoint lookups)."
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "manifests": {
      "type": "object",
      "title": "Manifest switches",
      "description": "Deep-merged into the chart's manifests values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "properties": {
        "certificates": {
          "type": "boolean"
        },
        "configmap_bin": {
          "type": "boolean"
        },
        "configmap_etc": {
          "type": "boolean"
        },
        "cron_credential_rotate": {
          "type": "boolean"
        },
        "cron_fernet_rotate": {
          "type": "boolean"
        },
        "deployment_api": {
          "type": "boolean"
        },
        "ingress_api": {
          "type": "boolean"
        },
        "job_bootstrap": {
          "type": "boolean"
        },
        "job_credential_cleanup": {
          "type": "boolean"
        },
        "job_credential_setup": {
          "type": "boolean"
        },
        "job_db_drop": {
          "type": "boolean"
        },
        "job_db_init": {
          "type": "boolean"
        },
        "job_db_sync": {
          "type": "boolean"
        },
        "job_domain_manage": {
          "type": "boolean"
        },
        "job_fernet_setup": {
          "type": "boolean"
        },
        "job_image_repo_sync": {
          "type": "boolean"
        },
        "job_rabbit_init": {
          "type": "boolean"
        },
        "network_policy": {
          "type": "boolean"
        },
        "pdb_api": {
          "type": "boolean"
        },
        "pod_rally_test": {
          "type": "boolean"
        },
        "secret_credential_keys": {
          "type": "boolean"
        },
        "secret_db": {
          "type": "boolean"
        },
        "secret_fernet_keys": {
          "type": "boolean"
        },
        "secret_ingress_tls": {
          "type": "boolean"
        },
        "secret_keystone": {
          "type": "boolean"
        },
        "secret_rabbitmq": {
          "type": "boolean"
        },
        "secret_registry": {
          "type": "boolean"
        },
        "service_api": {
          "type": "boolean"
        },
        "service_ingress_api": {
          "type": "boolean"
        }
      },
      "x-kubernetes-preserve-unknown-fields": true
    },
    "endpoints": {
      "type": "object",
      "title": "Endpoint overrides",
      "description": "Deep-merged into the chart's endpoints values. Declared fields are typed; any other key below this one passes through untyped (x-kubernetes-preserve-unknown-fields).",
      "x-kubernetes-preserve-unknown-fields": true
    }
  }
}
