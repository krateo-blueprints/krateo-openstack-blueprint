{{/* Krateo (#228), generated by 0.3.66 step 2: every drop-in source this chart's workloads use, as a JSON list in
     pod.etcSources form. Every container that mounts the main config receives these, Jobs included (0.3.65's
     ceilometer-db-sync, given none, failed its post-upgrade hook). Each entry renders only when its secret is
     generated, so with no reference the list is empty and nothing changes. */}}
{{- define "glance.dropin_etc_sources" -}}
{{- $out := list -}}
{{- with include "helm-toolkit.snippets.memcache_secret_key_etc_source" (tuple . "glance") }}{{- $out = append $out (fromJson .) }}{{- end }}
{{- with include "helm-toolkit.snippets.identity_dropin_etc_source" (tuple . (include "glance.identity_dropin_entries" . | fromJsonArray) "glance") }}{{- $out = append $out (fromJson .) }}{{- end }}
{{- $out | toJson -}}
{{- end -}}
