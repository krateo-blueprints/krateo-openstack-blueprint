{
  "name": "main: merge queue and required lint checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "SQUASH",
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 5,
        "max_entries_to_merge": 5,
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 5,
        "check_response_timeout_minutes": 60
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "values-schema",
            "integration_id": 15368
          },
          {
            "context": "umbrella-crd-size",
            "integration_id": 15368
          },
          {
            "context": "powerdns-runs",
            "integration_id": 15368
          },
          {
            "context": "migrate-to-pvc (mariadb)",
            "integration_id": 15368
          },
          {
            "context": "migrate-to-pvc (rabbitmq)",
            "integration_id": 15368
          },
          {
            "context": "job-hooks",
            "integration_id": 15368
          },
          {
            "context": "capability-roles",
            "integration_id": 15368
          },
          {
            "context": "capabilities-first-release",
            "integration_id": 15368
          },
          {
            "context": "image-tags",
            "integration_id": 15368
          },
          {
            "context": "examples-apiversion",
            "integration_id": 15368
          },
          {
            "context": "chart-deps",
            "integration_id": 15368
          },
          {
            "context": "lint-docs / lint-docs",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
